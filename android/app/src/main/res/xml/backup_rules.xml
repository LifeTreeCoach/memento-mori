<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup up to Android 11 (API <= 30); keep in sync with
     data_extraction_rules.xml (API 31+).
     Everything the app keeps:
     - shared_prefs: settings, people, Compass, lifespan answers
       (FlutterSharedPreferences), widget inputs (HomeWidgetPreferences),
       state of the plugins
     - except scheduled_notifications.xml: flutter_local_notifications' list
       of pending notifications. The alarms themselves are never restored, so
       a restored list would claim reminders that don't exist and the diff
       scheduler would skip them (lib/reminders/reminder_install_marker.dart
       covers restores that ignore these rules).
     - app_flutter/: path_provider's documents directory, holds the avatars
       (lib/data/avatar_store.dart: app_flutter/avatars/)
     Listing includes means nothing else is backed up, so cache/, code_cache/
     and no_backup/ stay out (the system never backs them up either). -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="root" path="app_flutter/" />
    <exclude domain="sharedpref" path="scheduled_notifications.xml" />
</full-backup-content>
