<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device-to-device transfer on Android 12+ (API 31+);
     keep in sync with backup_rules.xml (API <= 30), which explains the paths.
     Only shared_prefs and app_flutter/ (avatars) are included, so cache/,
     code_cache/ and no_backup/ stay out; the plugin's pending-notification
     list (shared_prefs/scheduled_notifications.xml) is excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="root" path="app_flutter/" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="root" path="app_flutter/" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
    </device-transfer>
</data-extraction-rules>
